class_name Quotes
## Real, verified quotes (docs/specs/content-guidelines.md §4).
## research/zitate_spiel.json is the game file (D-159): generated by
## research/scripts/build_all.py, it holds only the curated, verified quotes
## (research/auswahl.json order), only the fields the game reads, plus where each
## quote is used (`verwendung`). The full research (zitate_de.json) isn't shipped.

const QUOTES_PATH := "res://research/zitate_spiel.json"
## The fields every entry carries (architecture.md "Quotes"); checked by the tests.
const FIELDS := ["id", "sprecher", "partei", "rolle_damals", "zitat", "datum", "kontext", "kontext_kurz", "quellen", "verwendung"]

static var _quotes := {}
static var _uses := {}
static var _album: Array = []
static var _loaded := false


static func _load() -> void:
	if _loaded:
		return
	_loaded = true
	for q in _read_json(QUOTES_PATH):
		var id: String = q["id"]
		_quotes[id] = q
		_album.append(id)
		for use in q.get("verwendung", []):
			if not _uses.has(use):
				_uses[use] = []
			_uses[use].append(id)


static func _read_json(path: String) -> Array:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_warning("Quotes: cannot open %s" % path)
		return []
	var data = JSON.parse_string(f.get_as_text())
	return data if data is Array else []


static func get_quote(id: String) -> Dictionary:
	_load()
	return _quotes.get(id, {})


static func ids_for(use: String) -> Array:
	_load()
	return _uses.get(use, [])


static func album_ids() -> Array:
	_load()
	return _album


static func random_for(use: String, rng: RandomNumberGenerator = null) -> String:
	var ids := ids_for(use)
	if ids.is_empty():
		return ""
	var i := rng.randi_range(0, ids.size() - 1) if rng else randi_range(0, ids.size() - 1)
	return ids[i]


static func source_label(q: Dictionary) -> String:
	if q.is_empty():
		return ""
	var date: String = q.get("datum", "")
	var parts := date.split("-")
	var nice := date
	if parts.size() == 3:
		nice = "%s.%s.%s" % [parts[2], parts[1], parts[0]]
	elif parts.size() == 2:
		nice = "%s/%s" % [parts[1], parts[0]]
	var who: String = q.get("sprecher", "")
	var party: String = q.get("partei", "")
	if party != "" and party != "—" and party != "-" and not who.contains("(" + party):
		who += " (%s)" % party
	return "%s, %s" % [who, nice]


## One short line explaining what the quote was about and where it was said.
static func context_label(q: Dictionary) -> String:
	return str(q.get("kontext_kurz", ""))
